.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini
*.iml

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Local backups (git is the backup now) ──────────────────────────────────
*.bak

